// t2_protocol.j8 — 面向协议示例：静态派发、默认实现、存在类型盒（动态派发）、泛型约束
protocol Shape {
    f64 area(this);
    f64 perimeter(this) { return 0.0; }   // 默认实现：未覆盖的类型自动使用
}

struct Circle { f64 r; }
struct Rect { f64 w; f64 h; }

impl Shape for Circle {
    f64 area(this) { return 3.14159 * this->r * this->r; }
}
impl Shape for Rect {
    f64 area(this) { return this->w * this->h; }
}

f64 total_area<T: Shape>(T a, T b) {
    return a.area() + b.area();
}

void main() {
    Circle c = {2.0};
    Rect r = {3.0, 4.0};

    // 静态派发
    print(c.area());        // 12.566360
    print(r.area());        // 12.000

    // 默认实现（Circle 未定义 perimeter → 用协议默认体）
    print(c.perimeter());   // 0.000

    // 存在类型盒 + 动态派发（witness 表）
    Shape s1 = c;
    Shape s2 = r;
    print(s1.area());       // 12.566360
    print(s2.area());       // 12.000

    // 泛型 + 协议约束
    print(total_area<Circle>(c, c));   // 25.132720
    print(total_area<Rect>(r, r));     // 24.000

    // 协议盒拷贝
    Shape box = s1;
    print(box.area());      // 12.566360
}
