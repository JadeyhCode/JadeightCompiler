// t3_ecs.j8 — ECS 示例：实体、组件、系统
component Pos { i32 x; i32 y; }
component Vel { i32 vx; i32 vy; }
component Health { i32 hp; }

// 系统：对拥有 Pos+Vel 的实体做物理积分
system Physics: Pos, Vel {
    fn update(ent e) {
        get<Pos>(e)->x = get<Pos>(e)->x + get<Vel>(e)->vx;
        get<Pos>(e)->y = get<Pos>(e)->y + get<Vel>(e)->vy;
    }
}

// 系统：对拥有 Health 的实体回血
system Regen: Health {
    fn update(ent e) {
        get<Health>(e)->hp = get<Health>(e)->hp + 1;
    }
}

void main() {
    ent hero = spawn();
    ent ghost = spawn();

    add<Pos>(hero, 0, 0);
    add<Vel>(hero, 2, 3);
    add<Health>(hero, 100);
    add<Pos>(ghost, 50, 50);   // ghost 无 Vel：不被 Physics 处理

    run<Physics>();
    print(get<Pos>(hero)->x);  // 2
    print(get<Pos>(hero)->y);  // 3
    print(get<Pos>(ghost)->x); // 50（未被处理）

    run<Regen>();
    print(get<Health>(hero)->hp);  // 101

    // 组件查询与移除
    print(has<Vel>(hero));     // true
    remove<Vel>(hero);
    print(has<Vel>(hero));     // false

    // 实体生命周期
    print(alive(ghost));       // true
    despawn(ghost);
    print(alive(ghost));       // false
    print(entity_count());     // 1
}
