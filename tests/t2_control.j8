// t2_control.j8 — 控制流：if/else、while、do-while、for、break、continue
void main() {
    // if / else
    i32 a = 10;
    if (a > 5) {
        print("big");
    } else {
        print("small");
    }
    if (a < 5) {
        print("wrong");
    } else {
        print("right");
    }
    // if-else if 链（嵌套 else 块）
    u32 score = 75;
    if (score >= 90) {
        print("A");
    } else if (score >= 60) {
        print("B");
    } else {
        print("C");
    }

    // while 求和 1..10
    u32 sum = 0;
    u32 i = 1;
    while (i <= 10) {
        sum = sum + i;
        i = i + 1;
    }
    print(sum);          // 55

    // do-while：至少执行一次
    u32 n = 0;
    do {
        n = n + 1;
    } while (n < 3);
    print(n);            // 3
    do {
        n = n + 1;
    } while (false);
    print(n);            // 4（证明 do-while 至少执行一次）

    // for 循环
    u32 acc = 0;
    for (u32 k = 1; k <= 5; k = k + 1) {
        acc = acc + k;
    }
    print(acc);          // 15

    // break / continue
    u32 found = 0;
    for (u32 k = 0; k < 100; k = k + 1) {
        if (k == 7) {
            found = k;
            break;
        }
    }
    print(found);        // 7

    u32 oddSum = 0;
    for (u32 k = 1; k <= 10; k = k + 1) {
        if (k % 2 == 0) {
            continue;
        }
        oddSum = oddSum + k;
    }
    print(oddSum);       // 1+3+5+7+9 = 25

    // 嵌套循环
    u32 pairs = 0;
    for (u32 x = 0; x < 3; x = x + 1) {
        for (u32 y = 0; y < 4; y = y + 1) {
            pairs = pairs + 1;
        }
    }
    print(pairs);        // 12

    // 逻辑短路
    u32 calls = 0;
    bool r1 = false && (calls = calls + 1) > 0;
    print(r1);           // false
    print(calls);        // 0（右侧未执行）
    bool r2 = true || (calls = calls + 1) > 0;
    print(r2);           // true
    print(calls);        // 0（右侧未执行）

    // 三目
    u32 m = (3 > 2) ? 111 : 222;
    print(m);            // 111
    u32 m2 = (3 < 2) ? 111 : 222;
    print(m2);           // 222
}
