// t6_fold.j8 — 常量折叠/传播：验证 O2 下表达式在编译期求值且结果正确
u32 const_math() {
    // 纯常量表达式：O2 折叠成单个常量
    return (1 + 2) * 3 - 4 / 2 + 100 % 7;
}

u32 fold_params(u32 a, u32 b) {
    // 部分折叠：a 已知、b 已知时逐语句传播
    u32 x = a + b;
    u32 y = x * 2;
    u32 z = y + 1000;
    return z;
}

void main() {
    // 直接常量折叠
    print(2 + 3 * 4);             // 14
    print((10 - 3) * (6 + 2));    // 56
    print(100 / 7);               // 14
    print(100 % 7);               // 2
    print(1 << 10);               // 1024
    print((255 & 240) | 15);      // 255
    print(5 < 3);                 // false
    print(5 >= 3);                // true
    print(7 == 7);                // true
    print(7 != 7);                // false
    print(1 + 2 > 3 ? 100 : 200); // 200（折叠后条件为假）
    print(2 * 2 == 4 ? 100 : 200);// 100
    print(0xABCD & 0xFFFF);       // 43981
    print(0x1234 | 0x0F00);       // 0x1F34 = 7988

    // 常量传播：const 变量参与表达式
    u32 c1 = 5;
    u32 c2 = c1 * 10;
    u32 c3 = c2 + 7;
    print(c3);                    // 57

    // 常量条件消除死分支
    u32 mode = 2;
    if (mode == 2) {
        print("fast");
    } else {
        print("slow");
    }

    // 函数内折叠
    print(const_math());          // 7+...  (1+2)*3 - 4/2 + 100%7 = 9-2+2 = 9

    // 调用时参数折叠
    print(fold_params(3, 4));     // (3+4)*2+1000 = 1014

    // 折叠后的循环边界（验证折叠与循环协同）
    u32 total = 0;
    u32 n = 2 + 3;                // 5
    for (u32 i = 0; i < n; i = i + 1) {
        total = total + i * i;
    }
    print(total);                 // 0+1+4+9+16 = 30

    // 浮点折叠
    print(1.5 * 2.0);             // 3.000
    print(10.0 / 4.0);            // 2.500
    print((2.0 + 3.0) * 4.0);     // 20.000
}
